# Pokémon Data Platform — environment configuration.
# Development template only. `make start` creates `.env.dev` with unique secrets.
# For production, create `.env.prod` explicitly with unique strong credentials.

# ─── Host ports (change to avoid conflicts on your machine) ──────────────────
APP_PORT=8000
AIRFLOW_PORT=8080
STREAMLIT_PORT=8501

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=pokemon_data
APP_READER_PASSWORD=
APP_WRITER_PASSWORD=
AIRFLOW_DB_PASSWORD=

# Local Python commands need a full URL (or explicit POSTGRES_* variables).
# DATABASE_URL=postgresql+psycopg2://pokemon_writer:<encoded password>@localhost:5432/pokemon_data

# ─── Application / PokéAPI ingestion ─────────────────────────────────────────
API_BASE_URL=https://pokeapi.co/api/v2
API_RATE_LIMIT=20
# Concurrent detail fetches (the mirror is network-bound; raise to go faster).
API_CONCURRENCY=8
LOG_LEVEL=INFO

# ─── Airflow security ────────────────────────────────────────────────────────
# `make start` fills blanks in .env.dev only. Fill .env.prod explicitly and
# never commit real secrets:
#   AIRFLOW_FERNET_KEY:  python3 -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
#   AIRFLOW_JWT_SECRET:  openssl rand -hex 32
AIRFLOW_FERNET_KEY=
AIRFLOW_JWT_SECRET=
AIRFLOW_BASE_URL=http://localhost:8080

# ─── Airflow admin user (created by airflow-init) ────────────────────────────
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=
AIRFLOW_ADMIN_EMAIL=admin@example.com
AIRFLOW_ADMIN_FIRSTNAME=Admin
AIRFLOW_ADMIN_LASTNAME=User
MIRROR_POOL_SLOTS=1
