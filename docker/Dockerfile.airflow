FROM apache/airflow:slim-3.3.2-python3.14

USER root

# curl is needed for the api-server healthcheck. No build tools required: every
# dependency below ships a manylinux wheel for cp314, so nothing is compiled.
RUN apt-get update && \
    apt-get install -y --no-install-recommends curl && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

USER airflow

# Install the Airflow extra and core application runtime using the complete
# hashed resolution exported from uv.lock. This also brings any packages already
# present in the base image to the locked versions instead of resolving their
# transitive dependencies independently at image-build time.
COPY docker/airflow-requirements.txt /tmp/airflow-requirements.txt
RUN pip install --no-cache-dir --no-deps --require-hashes -r /tmp/airflow-requirements.txt

# Fail the image build if the provider installation leaves an inconsistent
# dependency environment (the Airflow base image has its own constraints).
RUN pip check

# Raw-JSON API cache dir, owned by the airflow user so a mounted volume here is
# writable (the relative "cache" dir resolves to /opt/airflow/cache at runtime).
RUN mkdir -p /opt/airflow/cache

# Copy application code
COPY src/ /opt/airflow/src/
COPY docker/airflow-init.sh /opt/airflow/airflow-init.sh

# Set environment variables
ENV PYTHONPATH=/opt/airflow
